  "NEOW.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-2.ancient": "[sine]...Try... ...again...[/sine]",
  
  
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.ancient": "[thinky_dots]A kobold? How novel.[/thinky_dots]",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.next": "Respond",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.char": "Hold on, I have no intention of-.",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.next": "Continue",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-2.ancient": "[thinky_dots]Be at ease. I have no need for a warren.\nTake a piece of me as a parting gift.[/thinky_dots]",

  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0.ancient": "[thinky_dots]What of your dragon?[/thinky_dots]",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0.next": "Respond",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-1.char": "What?",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-1.next": "Continue",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-2.ancient": "[thinky_dots]You are a kobold. You are not in service to a dragon?[/thinky_dots]",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-2.next": "Respond?",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-3.char": "...",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-3.next": "...",
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-4.ancient": "[thinky_dots]A sore topic, I see...[/thinky_dots]",
  
  "PAEL.talk.PICKLERFRIGIL-PICKLER_FRIGIL.2-0r.ancient": "[thinky_dots]The small dragon returns.[/thinky_dots]",


  "DARV.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.ancient": "You look like a lizard of discerning taste!\nHow about you take a look at my wares?",
