  "OROBAS.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-2.ancient": "New friend!! Gift for new friend!",
  
  "OROBAS.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0r.ancient": "Small friend is back!!",

  "OROBAS.talk.PICKLERFRIGIL-PICKLER_FRIGIL.2-0r.ancient": "Blue friend! So cold!!",
  
  
  "TANX.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.ancient": "LIZARD!! WHERE IS YOUR WEAPON!!",
  "TANX.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.next": "Respond",
  "TANX.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.char": "I've gotten this far without one.",
