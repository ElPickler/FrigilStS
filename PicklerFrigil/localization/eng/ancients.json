  "NEOW.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-3.ancient": "[sine]..knowledge.. lies.. at.. ...the top..[/sine]",
  
  "NEOW.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0.char": "Did I die?!",
  "NEOW.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0.next": "Continue",
  "NEOW.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-1.ancient": "[sine]..I... ..brought... ..you... ..back...[/sine]",
