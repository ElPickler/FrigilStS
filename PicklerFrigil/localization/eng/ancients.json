  "DARV.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.char": "[i][font_size=14]...Kobold.[/font_size][/i]",
  "DARV.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.next": "Continue",
  "DARV.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-2.ancient": "My mistake! Let's build you a hoard befitting a dragon, eh?",

  "DARV.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0r.ancient": "The [sine]kobold[/sine] is back! Wanna take a look at my collection?",
  
  
  "OROBAS.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.ancient": "New friend?! Small friend?! Cute friend?!",
  "OROBAS.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.next": "Friend?",
  "OROBAS.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.ancient": "I- Sure?",
