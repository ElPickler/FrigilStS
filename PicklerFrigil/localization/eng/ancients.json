  "TANX.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-2.ancient": "WHAT!!",

  
  "NONUPEIPE.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.ancient": "Diminutive creature, you've fought long to arrive.\nApproach, and receive of me my blessings to climb higher.",
  "NONUPEIPE.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-0.next": "Next",
  "NONUPEIPE.talk.PICKLERFRIGIL-PICKLER_FRIGIL.0-1.char": "If you insist...",

  "NONUPEIPE.talk.PICKLERFRIGIL-PICKLER_FRIGIL.1-0r.ancient": "You return. Be not discouraged, as within you flows the blood of dragons."
